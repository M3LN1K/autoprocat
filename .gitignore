# =============================================================================
# 1С-Битрикс: Стандартный .gitignore
# =============================================================================
bitrix/
.osp/
.gigacode/
include/
# -----------------------------------------------------------------------------
# 1. Системный кэш и временные файлы (Генерируются автоматически, не коммитим!)
# -----------------------------------------------------------------------------
/bitrix/cache/
/bitrix/managed_cache/
/bitrix/stack_cache/
/bitrix/tmp/
/bitrix/backup/
/bitrix/modules/main/classes/general/stack_cache.php

# -----------------------------------------------------------------------------
# 2. Конфигурационные файлы с доступами к БД и локальными настройками
# (Храните их в .env или настраивайте на сервере вручную)
# -----------------------------------------------------------------------------
/bitrix/.settings.php
/bitrix/.settings_extra.php
/bitrix/php_interface/dbconn.php
/bitrix/php_interface/.settings.php
/local/.settings.php
/local/php_interface/dbconn.php
/local/php_interface/.settings.php

# -----------------------------------------------------------------------------
# 3. Пользовательские загрузки (Изображения, документы, медиа)
# ВАЖНО: Папка /upload/ может весить гигабайты. Её НЕ рекомендуется хранить в Git.
# Синхронизируйте её отдельно (например, через rsync или скрипт деплоя).
# -----------------------------------------------------------------------------
/upload/
# Если вам критично коммитить пустую структуру папок, раскомментируйте строку ниже:
# !/upload/.gitkeep

# -----------------------------------------------------------------------------
# 4. Зависимости и инструменты сборки (Frontend/Backend)
# -----------------------------------------------------------------------------
/vendor/
/node_modules/
/package-lock.json
/yarn.lock
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/dist/
/build/

# -----------------------------------------------------------------------------
# 5. Файлы операционных систем и IDE
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 6. Логи и временные архивы
# -----------------------------------------------------------------------------
*.log
/local/logs/
*.zip
*.tar.gz
*.rar
.tmp
.temp
.gitconfig

# -----------------------------------------------------------------------------
# 7. Файлы окружения (Environment variables)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local